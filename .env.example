# ClinScribe AI — Backend API Configuration

# Server
APP_NAME=ClinScribe AI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql+asyncpg://clinscribe:clinscribe_dev@localhost:5432/clinscribe_db
DATABASE_SYNC_URL=postgresql://clinscribe:clinscribe_dev@localhost:5432/clinscribe_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI/ML Services
ASR_PROVIDER=demo
ASR_MODEL_PATH=./models/indicconformer
WHISPER_MODEL=medium
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=

# Demo Mode
DEMO_MODE=true
DEMO_DATA_PATH=./datasets/synthetic

# Audio
MAX_AUDIO_DURATION_SECONDS=3600
AUDIO_SAMPLE_RATE=16000
TEMP_AUDIO_DIR=./tmp/audio

# Privacy
DATA_RETENTION_DAYS=90
ENABLE_AUDIT_LOG=true
ENCRYPT_AT_REST=false

# Logging
LOG_LEVEL=INFO
